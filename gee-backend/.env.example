# ==============================================================================
# AgriEye Earth Engine Backend Environment Variables
# ==============================================================================

# Supabase JWT Secret (found in Supabase Dashboard -> Project Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Google Earth Engine Service Account Credentials
EE_SERVICE_ACCOUNT=agrieye-gee-sa@your-gcp-project.iam.gserviceaccount.com
# Either provide the path to your service account JSON file:
EE_KEY_FILE=/path/to/gee-service-account-key.json
# OR paste the raw private key content as an escaped string:
EE_PRIVATE_KEY_DATA=""

# Operational Mode ('auto', 'true' to force mock mode, 'false' for production GEE only)
MOCK_MODE=auto

PORT=8080
