# ==============================================================================
# AgriEye — Frontend Environment Configuration
# ==============================================================================

# Supabase Project URL & Anon Public Key
# Found in: Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Earth Engine API Service (FastAPI running on Cloud Run or local)
# In development, leave blank or point to http://localhost:8080.
# The app includes an automatic offline simulation engine if GEE is offline.
VITE_GEE_API_URL=http://localhost:8080

# Map Tiles & Services (optional custom keys; defaults use free Esri World Imagery & OSM)
VITE_ESRI_API_KEY=

# Stripe Billing (Public Key for Pro/Business subscriptions)
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Error Reporting & Analytics (Optional)
VITE_PLAUSIBLE_DOMAIN=agrieye.io
VITE_SENTRY_DSN=
